<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Marvel.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== Tipografia (Poppins, tamanhos do Figma em sp) ===== -->
    <!-- 50 / Medium — nome gigante na tela de membros -->
    <style name="Text.Marvel.Hero" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">50sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <!-- 40 / SemiBold — nome no header do detalhe do personagem -->
    <style name="Text.Marvel.Display" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <!-- 34 / SemiBold — nome da equipe no header -->
    <style name="Text.Marvel.TeamName" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/marvel_red</item>
    </style>
    <!-- 28 / Medium — títulos de página e banner -->
    <style name="Text.Marvel.Headline" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <!-- 26 / Medium — nome do personagem (detalhe) -->
    <style name="Text.Marvel.Title" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <!-- 24 / Regular — botões onboarding / Membros -->
    <style name="Text.Marvel.Button" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <!-- 22 / Medium — nome no card de busca / título do arco -->
    <style name="Text.Marvel.CardTitle" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <!-- 20 / Medium — título de seção e toolbar -->
    <style name="Text.Marvel.Section" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <!-- 20 / Light — descrição onboarding -->
    <style name="Text.Marvel.Lead" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:gravity">center</item>
    </style>
    <!-- 18 / Medium — subtítulo (Sobre, Poderes, nome da equipe no card) -->
    <style name="Text.Marvel.Subtitle" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <!-- 18 / Light — nome real no detalhe -->
    <style name="Text.Marvel.SubtitleLight" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <!-- 16 / Medium — ano da timeline / título do card do arco -->
    <style name="Text.Marvel.Label" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <!-- 16 / Regular — "Ver todas" -->
    <style name="Text.Marvel.Link" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/marvel_red</item>
    </style>
    <!-- 15 / Medium — valor de info / chip de poder -->
    <style name="Text.Marvel.Value" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <!-- 14 / Regular — corpo / chips -->
    <style name="Text.Marvel.Body" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <!-- 14 / Light — nome real no card / descrição -->
    <style name="Text.Marvel.BodyLight" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <!-- 14 / Regular secundário — rótulos "Primeira aparição" -->
    <style name="Text.Marvel.Caption" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>
    <!-- 13 / Medium — títulos de HQ, info cards -->
    <style name="Text.Marvel.Small" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <style name="Text.Marvel.SmallSecondary" parent="Text.Marvel.Small">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>
    <!-- 12 / Light — hint da busca -->
    <style name="Text.Marvel.Hint" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/app_text_muted</item>
    </style>
    <!-- 11 / Regular e 9 / Light — card da timeline -->
    <style name="Text.Marvel.Tiny" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <style name="Text.Marvel.Micro" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <!-- ===== Componentes ===== -->
    <style name="Widget.Marvel.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="tint">@color/app_text_primary</item>
    </style>
    <style name="Widget.Marvel.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/marvel_red</item>
    </style>
    <style name="Widget.Marvel.Card.Round" parent="Widget.Marvel.Card">
        <item name="cardCornerRadius">25dp</item>
    </style>
    <style name="Widget.Marvel.Chip" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Widget.Marvel.PowerChip" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_chip_blue</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Widget.Marvel.TeamTag" parent="Widget.Marvel.TextView">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/marvel_yellow</item>
        <item name="android:background">@drawable/bg_tag_red</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearance.Marvel.Avatar" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">25dp</item>
    </style>
</resources>
