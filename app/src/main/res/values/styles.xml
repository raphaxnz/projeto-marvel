<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Marvel.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Marvel.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Marvel.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Marvel.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Widget.Marvel.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/app_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Marvel.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
