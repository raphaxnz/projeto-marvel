<?xml version="1.0" encoding="utf-8"?>
<!-- HQ em grid (3 colunas): mesma anatomia do item_comic, mas largura flexível e espaçamento vertical 38dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="38dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ivCover"
        android:layout_width="@dimen/comic_width"
        android:layout_height="@dimen/comic_height"
        android:background="@drawable/bg_comic_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@drawable/img_comic_uncanny_2" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Text.Marvel.Small"
        android:layout_width="@dimen/comic_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="The uncanny" />

    <TextView
        android:id="@+id/tvIssue"
        style="@style/Text.Marvel.SmallSecondary"
        android:layout_width="@dimen/comic_width"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="#1" />
</LinearLayout>
