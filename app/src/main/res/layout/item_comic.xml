<?xml version="1.0" encoding="utf-8"?>
<!-- HQ (Figma: capa 100x156, título 13/500 primário, edição 13/500 secundário; gap horizontal 35dp) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/comic_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="35dp"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ivCover"
        android:layout_width="@dimen/comic_width"
        android:layout_height="@dimen/comic_height"
        android:background="@drawable/bg_comic_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@drawable/img_comic_uncanny_1" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Text.Marvel.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="The uncanny" />

    <TextView
        android:id="@+id/tvIssue"
        style="@style/Text.Marvel.SmallSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="#1" />
</LinearLayout>
