<?xml version="1.0" encoding="utf-8"?>
<!--
  Herói em destaque (Home) e Personagem (detalhe do arco).
  Figma: círculo 80dp colorido; arte do personagem 90x114 sobressai acima do círculo.
  Célula de 95dp de largura (80 + gap 15).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="95dp"
    android:layout_height="@dimen/avatar_art_size"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <View
        android:id="@+id/vCircle"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="7dp"
        android:layout_marginBottom="11dp"
        android:background="@drawable/bg_circle_red" />

    <ImageView
        android:id="@+id/ivArt"
        android:layout_width="90dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        tools:src="@drawable/img_char_spider" />
</FrameLayout>
