<?xml version="1.0" encoding="utf-8"?>
<!-- Banner da Home. Frame Figma 12:121: área 412x220 dentro do pager, título em y≈93 relativo ao banner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/bannerBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_banner_gradient" />

    <ImageView
        android:id="@+id/ivWatermark"
        android:layout_width="259dp"
        android:layout_height="104dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="36dp"
        android:alpha="0.10"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/img_logo_marvel" />

    <ImageView
        android:id="@+id/ivArt"
        android:layout_width="140dp"
        android:layout_height="141dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="69dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvBannerTitle"
        style="@style/Text.Marvel.Headline"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="93dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/white" />
</FrameLayout>
